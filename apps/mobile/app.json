{
  "expo": {
    "name": "PfotenNetz",
    "slug": "pfotennetz",
    "scheme": "pfotennetz",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/pfotennetz-logo.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pfotennetz",
      "deploymentTarget": "16.4",
      "associatedDomains": ["webcredentials:pfotennetz.app"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PfotenNetz benötigt Ihren Standort für die Karten-Suche und Live-Tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PfotenNetz benötigt Ihren Standort für Hintergrund-Tracking bei aktiven Gassi-Runden.",
        "NSFaceIDUsageDescription": "PfotenNetz verwendet Face ID für sichere Anmeldung.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "app.pfotennetz",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "pfotennetz.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/pfotennetz-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/pfotennetz-logo.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-location",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "PfotenNetz benötigt Zugriff auf dein Mikrofon für Sprachnachrichten.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      [
        "expo-image-picker",
        {
          "photosPermission": "PfotenNetz benötigt Zugriff auf deine Fotos, um Tierbilder zu speichern.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
