{
  "expo": {
    "name": "PfotenNetz",
    "slug": "pfotennetz",
    "scheme": "pfotennetz",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/pfotennetz-logo.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pfotennetz",
      "deploymentTarget": "16.4",
      "associatedDomains": ["webcredentials:pfotennetz.app"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PfotenNetz benötigt Ihren Standort für die Karten-Suche und Live-Tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PfotenNetz benötigt Ihren Standort für Hintergrund-Tracking bei aktiven Gassi-Runden.",
        "NSFaceIDUsageDescription": "PfotenNetz verwendet Face ID für sichere Anmeldung.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "app.pfotennetz",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pfotennetz.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PfotenNetz benötigt Kamerazugriff zum Scannen von Notfallkarten.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/pfotennetz-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/pfotennetz-logo.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "PfotenNetz benötigt deinen Standort für Karten und Live-Tracking.",
          "locationAlwaysAndWhenInUsePermission": "PfotenNetz benötigt deinen Standort für Hintergrund-Tracking bei aktiven Gassi-Runden."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "PfotenNetz benötigt Zugriff auf dein Mikrofon für Sprachnachrichten.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      [
        "expo-image-picker",
        {
          "photosPermission": "PfotenNetz benötigt Zugriff auf deine Fotos, um Tierbilder zu speichern.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b494192-9073-45e1-802b-844fe335c8b7"
      }
    },
    "owner": "knobi4711"
  }
}
