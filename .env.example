# PfotenNetz Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets

# Supabase Project Configuration
# Project ID: njkyujhbcolvtcnlahsk

# --- Public Client Configuration (may appear in client bundles) ---
# Root-level generic names
SUPABASE_URL=https://njkyujhbcolvtcnlahsk.supabase.co
SUPABASE_ANON_KEY=

# Expo / React Native (explicit for Expo bundler)
EXPO_PUBLIC_SUPABASE_URL=https://njkyujhbcolvtcnlahsk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Next.js / Web (explicit for Next.js bundler)
NEXT_PUBLIC_SUPABASE_URL=https://njkyujhbcolvtcnlahsk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secret Values (NEVER in client bundles, NEVER in EXPO_PUBLIC_/NEXT_PUBLIC_) ---
# Supabase CLI Access Token (for `supabase link`, `supabase db push`, etc.)
SUPABASE_ACCESS_TOKEN=

# Server-side administration only (test-data scripts and workers)
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth-E-Mails über Brevo (scripts/configure-auth-mail.mjs) ---
# Werte aus Brevo: Settings -> SMTP & API -> SMTP
AUTH_MAIL_SMTP_HOST=smtp-relay.brevo.com
AUTH_MAIL_SMTP_PORT=587
AUTH_MAIL_SMTP_USER=
AUTH_MAIL_SMTP_PASS=
# Absender (Domain muss in Brevo authentifiziert sein)
AUTH_MAIL_FROM=noreply@pfotennetz.app
AUTH_MAIL_FROM_NAME=PfotenNetz
# Mails pro Stunde (Brevo Free: 300/Tag)
AUTH_MAIL_RATE_LIMIT=60

# OpenCode Stitch MCP (development tooling only)
STITCH_API_KEY=
